DATABASE_URL=
SECRET_KEY=
ALGORITHM=HS256

# Session lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated frontend origins allowed to make credentialed requests (no trailing slash)
FRONTEND_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Auth cookies
# lax  -> frontend proxies /api to this backend (Vercel rewrite) - works in all browsers
# none -> frontend calls this backend directly from another domain (Safari will block it)
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
# COOKIE_DOMAIN=
